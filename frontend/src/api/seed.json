    { "id": 1, "name": "Remote Work", "topic": "Is remote work better than office work?", "creatorId": 2 },
    { "id": 2, "name": "AI in Schools", "topic": "Should students be allowed to use AI for homework?", "creatorId": 3 },
    { "id": 3, "name": "Four Day Week", "topic": "Should every company move to a four-day work week?", "creatorId": 1 }
  ],
